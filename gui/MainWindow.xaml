<Window x:Class="LocaleBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocaleBridge" Height="640" Width="920" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Background="{StaticResource Bg}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="2,0,0,18">
      <TextBlock Text="LocaleBridge" Style="{StaticResource H1}" FontSize="24" />
      <TextBlock Text="以指定語系啟動任何應用程式 — 不改變系統地區設定" Style="{StaticResource Hint}"
                 Margin="0,4,0,0" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左：設定檔清單 -->
      <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="語系設定檔" Style="{StaticResource Label}" Margin="4,2,0,10" />
          <ListBox Grid.Row="1" x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="＋ 新增設定檔" Style="{StaticResource Ghost}" Click="New_Click" />
            <Button Grid.Column="2" Content="刪除" Style="{StaticResource Ghost}" Click="Delete_Click"
                    Foreground="{StaticResource Danger}" />
          </Grid>
        </Grid>
      </Border>

      <!-- 右：編輯 + 右鍵選單 + 啟動 -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- 編輯設定檔 -->
          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="編輯設定檔" Style="{StaticResource Label}" FontSize="13" Margin="0,0,0,14" />
              <TextBlock Text="名稱" Style="{StaticResource Label}" />
              <TextBox x:Name="NameBox" />
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Code Page" Style="{StaticResource Label}" />
                  <TextBox x:Name="CpBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="LCID (16 進位)" Style="{StaticResource Label}" />
                  <TextBox x:Name="LcidBox" />
                </StackPanel>
              </Grid>
              <TextBlock Text="快速套用預設" Style="{StaticResource Label}" Margin="0,16,0,8" />
              <WrapPanel x:Name="PresetPanel" />
              <Button Content="儲存設定檔" Style="{StaticResource Primary}" Click="Save_Click"
                      HorizontalAlignment="Left" Margin="0,18,0,0" />
            </StackPanel>
          </Border>

          <!-- 右鍵選單 -->
          <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="檔案總管右鍵選單" Style="{StaticResource Label}" FontSize="13" Margin="0,0,0,8" />
              <TextBlock Style="{StaticResource Hint}"
                         Text="安裝後，對任何 .exe 按右鍵即可選「用 LocaleBridge 啟動」→ 選一個設定檔來啟動。（Windows 11 在「顯示其他選項」裡）" />
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="安裝 / 更新右鍵選單" Style="{StaticResource Primary}" Click="InstallMenu_Click" />
                <Button Content="移除" Style="{StaticResource Ghost}" Click="RemoveMenu_Click" Margin="10,0,0,0" />
                <TextBlock x:Name="MenuStatus" VerticalAlignment="Center" Margin="14,0,0,0"
                           Style="{StaticResource Hint}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 立即啟動 -->
          <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="立即啟動" Style="{StaticResource Label}" FontSize="13" Margin="0,0,0,8" />
              <TextBlock Style="{StaticResource Hint}" Text="用左側選取的設定檔啟動指定程式。" />
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TargetBox" />
                <Button Grid.Column="2" Content="瀏覽…" Style="{StaticResource Ghost}" Click="Browse_Click" />
              </Grid>
              <Button Content="以選取的設定檔啟動" Style="{StaticResource Primary}" Click="Launch_Click"
                      HorizontalAlignment="Left" Margin="0,14,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
