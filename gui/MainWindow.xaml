<Window x:Class="LocaleBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:LocaleBridge"
        Title="LocaleBridge" Height="640" Width="920" MinHeight="560" MinWidth="820"
        Icon="LocaleBridge.ico" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Background="{StaticResource Bg}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="2,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="LocaleBridge" Style="{StaticResource H1}" FontSize="24" />
        <TextBlock Text="{l:T HeaderSub}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
      </StackPanel>
      <Button Grid.Column="1" Content="{l:T SwitchTo}" Style="{StaticResource Ghost}"
              VerticalAlignment="Top" Padding="12,7" FontSize="13" Click="SwitchLang_Click" />
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左：設定檔清單 -->
      <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{l:T Profiles}" Style="{StaticResource Label}" Margin="4,2,0,10" />
          <ListBox Grid.Row="1" x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{l:T NewProfile}" Style="{StaticResource Ghost}" Click="New_Click" />
            <Button Grid.Column="2" Content="{l:T Delete}" Style="{StaticResource Ghost}" Click="Delete_Click"
                    Foreground="{StaticResource Danger}" />
          </Grid>
        </Grid>
      </Border>

      <!-- 右：編輯 + 右鍵選單 + 啟動 -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- 編輯設定檔 -->
          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock x:Name="EditorTitle" Text="{l:T AddTitle}" Style="{StaticResource Label}"
                         FontSize="13" Margin="0,0,0,4" />
              <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14" Text="{l:T EditHint}" />

              <!-- ① 選語言（主要操作）-->
              <TextBlock Text="{l:T Step1}" Style="{StaticResource Label}" />
              <WrapPanel x:Name="PresetPanel" Margin="0,2,0,4" />

              <!-- ② 名稱 -->
              <TextBlock Text="{l:T Step2}" Style="{StaticResource Label}" Margin="0,14,0,6" />
              <TextBox x:Name="NameBox" />

              <!-- 進階（自訂編碼），預設收起 -->
              <CheckBox x:Name="AdvancedToggle" Content="{l:T Advanced}"
                        Margin="0,14,0,0" FontFamily="{StaticResource UiFont}"
                        Foreground="{StaticResource SubText}"
                        Checked="Advanced_Toggle" Unchecked="Advanced_Toggle" />
              <Grid x:Name="AdvancedPanel" Margin="0,10,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Code Page" Style="{StaticResource Label}" />
                  <TextBox x:Name="CpBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{l:T LcidHex}" Style="{StaticResource Label}" />
                  <TextBox x:Name="LcidBox" />
                </StackPanel>
              </Grid>

              <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="{l:T Save}" Style="{StaticResource Primary}" Click="Save_Click" />
                <Button x:Name="CancelEditBtn" Content="{l:T Cancel}" Style="{StaticResource Ghost}"
                        Click="CancelEdit_Click" Margin="10,0,0,0" Visibility="Collapsed" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 右鍵選單 -->
          <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="{l:T MenuTitle}" Style="{StaticResource Label}" FontSize="13" Margin="0,0,0,8" />
              <TextBlock Style="{StaticResource Hint}" Text="{l:T MenuHint}" />
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="{l:T MenuInstall}" Style="{StaticResource Primary}" Click="InstallMenu_Click" />
                <Button Content="{l:T MenuRemove}" Style="{StaticResource Ghost}" Click="RemoveMenu_Click" Margin="10,0,0,0" />
                <TextBlock x:Name="MenuStatus" VerticalAlignment="Center" Margin="14,0,0,0"
                           Style="{StaticResource Hint}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 立即啟動 -->
          <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="{l:T LaunchTitle}" Style="{StaticResource Label}" FontSize="13" Margin="0,0,0,8" />
              <TextBlock Style="{StaticResource Hint}" Text="{l:T LaunchHint}" />
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TargetBox" />
                <Button Grid.Column="2" Content="{l:T Browse}" Style="{StaticResource Ghost}" Click="Browse_Click" />
              </Grid>
              <Button Content="{l:T LaunchBtn}" Style="{StaticResource Primary}" Click="Launch_Click"
                      HorizontalAlignment="Left" Margin="0,14,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
